            "schema": {
              "default": "hi",
              "examples": [
                "a",
                "b"
              ],
              "maxLength": 10,
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "h",
            "required": false,
            "schema": {
              "default": "v",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/_Out"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get item",
        "tags": [
          "x"
        ]
