            "type": "array"
          },
          "status_code": {
            "title": "Status Code",
            "type": "integer"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
